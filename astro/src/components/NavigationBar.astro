---
// Static port of the old React component NavigationBar.jsx.
// Real <a href> links (crawlable). Every page shows the same items in the
// same order; the current one is inverted, never removed, so nothing moves.
import { APP_ROUTES, NAVIGATION_ITEMS } from '../config/site.js';

// Pages one level below a section pass backHref/backLabel so the top-left
// button returns to the section instead of home. The label is the path.
const { backHref = APP_ROUTES.home, backLabel = backHref } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (page) =>
  [page.path, ...(page.sections || [])].some(
    (path) => currentPath === path || currentPath.startsWith(`${path}/`)
  );
---

<nav class="navigation-bar">
  <div class="nav-back">
    <a href={backHref} class="nav-back-button">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
      <span>{backLabel}</span>
    </a>
  </div>

  <div class="nav-links">
    {NAVIGATION_ITEMS.map((page) => (
      <a
        href={page.path}
        class={`${page.isNowButton ? 'nav-now-button' : 'nav-link'}${isCurrent(page) ? ' is-current' : ''}`}
        aria-current={isCurrent(page) ? 'page' : undefined}
      >
        {page.label}
      </a>
    ))}
  </div>
</nav>
