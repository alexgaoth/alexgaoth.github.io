<script>
    // Hover a build-log row → the hero swaps to that project; leave the log →
    // hero falls back to the featured ship. Enhancement only: without JS the
    // hero statically shows the featured ship.
    const hero = document.getElementById("built-hero");
    const list = document.getElementById("built-log-list");
    if (hero && list) {
        const nameEl = document.getElementById("built-hero-name");
        const yearEl = document.getElementById("built-hero-year");
        const descEl = document.getElementById("built-hero-desc");
        const chipsEl = document.getElementById("built-hero-chips");
        const liveEl = document.getElementById("built-hero-live");
        const imgs = hero.querySelectorAll(".built-hero-img");

        const featured = {
            name: nameEl.textContent,
            year: yearEl.textContent,
            desc: descEl.textContent,
            tech: [...chipsEl.children].map((c) => c.textContent).join(" · "),
            status: liveEl.hidden ? "" : "live",
            href: hero.getAttribute("href"),
        };

        const show = (ship) => {
            nameEl.textContent = ship.name;
            yearEl.textContent = ship.year;
            descEl.textContent = ship.desc;
            chipsEl.replaceChildren(
                ...ship.tech.split(" · ").map((t) => {
                    const chip = document.createElement("span");
                    chip.className = "built-chip";
                    chip.textContent = t;
                    return chip;
                }),
            );
            liveEl.hidden = ship.status !== "live";
            hero.setAttribute("href", ship.href);
            imgs.forEach((img) =>
                img.classList.toggle("active", img.dataset.ship === ship.name),
            );
        };

        list.querySelectorAll(".ship-row").forEach((row) => {
            row.addEventListener("mouseenter", () => show(row.dataset));
        });
        list.addEventListener("mouseleave", () => show(featured));
    }
</script>


<script>
    // DOM choreography for the intro and return stages: the fixed title rise,
    // the directory reveal, the progress track and the scroll hint. The rail
    // panels themselves get no transition — the visual layer that drew them is
    // parked (see README), and this script paints nothing.
    //
    // Scroll state comes from lib/homeScroll.js, so a visual layer added later
    // reads the same numbers. Enhancement only: the static HTML is complete, and
    // on mobile or under prefers-reduced-motion none of this runs at all —
    // the page then reads as one continuous ledger, per DESIGN.md.
    import {
        motionEnabled,
        subscribe,
        INTRO_VH,
        RETURN_VH,
    } from "../lib/homeScroll.js";

    if (motionEnabled()) {
        const introSpacer = document.querySelector(".intro-spacer");
        const introTitle = document.querySelector(
            ".intro-spacer .title-section-parallax",
        );
        const introSub = introTitle && introTitle.querySelector(".title-sub");
        const returnSpacer = document.querySelector(".return-spacer");
        const returnStage = document.querySelector(".return-stage");
        const returnTitle =
            returnStage &&
            returnStage.querySelector(".cards-title .title-main");
        const returnSub =
            returnStage && returnStage.querySelector(".cards-title .title-sub");
        const returnCards =
            returnStage &&
            returnStage.querySelector(".cards-section-parallax > .grid-2col");
        const track = document.querySelector(".progress-track");
        const fill = document.querySelector(".progress-fill");
        let titleH = 0;

        if (introTitle) {
            // The parallax: the title leaves the flow and floats fixed over the
            // intro spacer — the page scrolls underneath while the title rises
            // on its own slower track.
            introTitle.style.cssText =
                "position:fixed;left:50%;transform:translateX(-50%);z-index:10;" +
                "max-width:1152px;width:calc(100% - 64px);";
        }

        // The fixed title rises from vertical centre to the top over the first
        // 55% of the intro scroll (quintic ease-out), pins there, and fades out
        // over the last 30%; the subtitle fades in over the last fifth of the
        // rise. All pure functions of the shared scroll state.
        const introFx = (state, vh) => {
            if (!introTitle) return;
            const eased = 1 - Math.pow(1 - state.rise, 5);
            const startTop = (vh - titleH) * 0.5;
            introTitle.style.top =
                (startTop + (80 - startTop) * eased).toFixed(1) + "px";
            const op = Math.max(0, 1 - Math.max(0, (state.intro - 0.7) / 0.3));
            introTitle.style.opacity = op.toFixed(3);
            introTitle.style.pointerEvents = op > 0 ? "auto" : "none";
            if (introSub) {
                introSub.style.opacity = Math.max(
                    0,
                    (state.rise - 0.8) / 0.2,
                ).toFixed(3);
            }
        };

        const revealFromGround = (el, p) => {
            if (!el) return;
            const eased = p * p * (3 - 2 * p);
            el.style.opacity = p > 0 ? "1" : "0";
            el.style.transform = `translateY(${((1 - eased) * 105).toFixed(1)}%)`;
        };

        // Return stage: the second directory heading rises through its own
        // bottom clip line, followed by the subtitle and the cards.
        const returnFx = (state) => {
            const rp = state.ret;
            revealFromGround(
                returnTitle,
                Math.min(1, Math.max(0, (rp - 0.46) / 0.38)),
            );
            revealFromGround(
                returnSub,
                Math.min(1, Math.max(0, (rp - 0.58) / 0.34)),
            );
            if (returnCards) {
                const cardP = Math.min(1, Math.max(0, (rp - 0.78) / 0.22));
                const eased = cardP * cardP * (3 - 2 * cardP);
                returnCards.style.opacity = cardP.toFixed(3);
                returnCards.style.transform = `translateY(${((1 - eased) * 24).toFixed(1)}px)`;
            }
        };

        subscribe(
            (state) => {
                const vh = innerHeight;
                introFx(state, vh);
                returnFx(state);
                if (track && fill) {
                    const trackedEnd = state.returnRect.bottom + scrollY;
                    track.style.display =
                        scrollY < trackedEnd ? "block" : "none";
                    fill.style.height = (state.total * 100).toFixed(2) + "%";
                }
            },
            {
                onResize: () => {
                    const vh = innerHeight;
                    if (introSpacer)
                        introSpacer.style.height =
                            Math.round(vh * INTRO_VH) + "px";
                    if (returnSpacer)
                        returnSpacer.style.height =
                            Math.round(vh * RETURN_VH) + "px";
                    if (introTitle) titleH = introTitle.offsetHeight;
                },
            },
        );

        // Scroll hint: appears after 5s idle, hidden the moment scrolling
        // resumes (the one timer-based piece — it's a hint, not choreography).
        const hint = document.querySelector(".scroll-hint");
        if (hint) {
            let hintT;
            const armHint = () => {
                hint.style.display = "none";
                clearTimeout(hintT);
                hintT = setTimeout(() => {
                    hint.style.display = "flex";
                }, 5000);
            };
            addEventListener("scroll", armHint, { passive: true });
            armHint();
        }
    }
</script>
