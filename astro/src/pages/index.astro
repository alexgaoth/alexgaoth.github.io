---
// Static port of the CRA MainPage: same content (title, BUILT → WRITING →
// EXPERIENCE rail, directory cards, footer strips) rendered as source HTML.
// The scroll-parallax choreography stays client-side-only in the CRA app and
// can return later as an island; content and links must not depend on it.
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, APP_ROUTES } from "../config/site.js";
import { content } from "../data/content.js";
import {
    SHIPS,
    TROPHIES,
    WRITINGS,
    DOORS,
    EXPERIENCE,
    EDUCATION,
    DOMAINS,
    TONGUES,
} from "../data/homeRailData.js";

const CARD_DESCRIPTIONS = {
    resume: "My professional experience and skills",
    projects: "Creative projects funded by my relentless mind",
    thoughts: "Ideas worth saying - maybe worth reading",
    quotes: "The good and the bad",
};

const shipHref = (ship) =>
    ship.anchor
        ? `${APP_ROUTES.projects}#project-${ship.anchor}`
        : APP_ROUTES.projects;

// SHIPS is the full ranked list (newest first); the panel shows the top X
// that fit the build log. Mobile trims further via .ship-mobile-hidden.
const HOME_SHIP_COUNT = 8;
const homeShips = SHIPS.slice(0, HOME_SHIP_COUNT);

// Hero shows the featured ship by default; hovering a build-log row swaps it
// (client enhancement only — the static default must stay complete).
const featured = homeShips[0];
---

<BaseLayout
    title={SITE.title}
    description={SITE.description}
    keywords={SITE.keywords}
    path={APP_ROUTES.home}
>
    <div class="page-container" style="background-color:#fff">
        <div
            class="content-wrapper"
            style="padding-top:2.5rem;padding-bottom:3rem"
        >
            <!-- Intro: empty scroll distance for the fixed-title rise (pre-migration
           parallax). The FX script fixes the title over it; without JS the
           spacer stays collapsed and the header reads statically. -->
            <div class="intro-spacer">
                <header
                    class="title-section-parallax"
                    style="position:relative"
                >
                    <h1 class="title-main">alex gaoth's directory</h1>
                    <div class="title-sub" style="padding-top:0.4rem">
                        <p>
                            I am alex gao, the additional 'th' is here so you
                            can find me easier
                        </p>
                        <p class="reverse-hidden">
                            'th' is the initials of my chinese first name, and u
                            can find me elsewhere all by alexgaoth
                        </p>
                        <p class="hidden">
                            mobile-first redesign coming — works better on
                            desktop for now
                        </p>
                    </div>
                </header>
            </div>

            <!-- ── 01 BUILT ── -->
            <section class="rail-panel">
                <span class="rail-eyebrow">// what i have</span>
                <h2 class="rail-title">
                    BUILT<span style="color:#ccc">.</span>
                </h2>
                <p class="rail-sub">
                    the true answers is uncountable many things but few of value
                </p>

                <div class="built-grid">
                    <!-- Hero — desktop only. Image swaps to match whichever row is hovered. -->
                    <a
                        href={shipHref(featured)}
                        class="built-hero"
                        id="built-hero"
                    >
                        <span class="built-hero-media">
                            {
                                homeShips.map((ship, i) => (
                                    <img
                                        src={ship.img}
                                        alt={ship.name}
                                        class:list={[
                                            "built-hero-img",
                                            { active: i === 0 },
                                        ]}
                                        data-ship={ship.name}
                                        loading={i === 0 ? "eager" : "lazy"}
                                    />
                                ))
                            }
                            <span
                                class="built-hero-live"
                                id="built-hero-live"
                                hidden={featured.status !== "live"}
                            >
                                <span
                                    class="now-dot rail-pulse"
                                    style="background:#0f6"></span>
                                LIVE
                            </span>
                        </span>
                        <span class="built-hero-body">
                            <span class="built-hero-head">
                                <span
                                    class="built-hero-name"
                                    id="built-hero-name">{featured.name}</span
                                >
                                <span class="rail-eyebrow" id="built-hero-year"
                                    >{featured.year}</span
                                >
                            </span>
                            <span class="built-hero-desc" id="built-hero-desc"
                                >{featured.desc ?? ""}</span
                            >
                            <span
                                class="built-hero-chips"
                                id="built-hero-chips"
                            >
                                {
                                    featured.tech
                                        .split(" · ")
                                        .map((t) => (
                                            <span class="built-chip">{t}</span>
                                        ))
                                }
                            </span>
                        </span>
                    </a>

                    <!-- Build log -->
                    <div class="built-log">
                        <div class="built-log-head">
                            <span class="rail-eyebrow" style="color:#666"
                                >// build log</span
                            >
                            <span class="rail-eyebrow" style="color:#bbb"
                                >desc ↓</span
                            >
                        </div>
                        <div class="built-log-cols">
                            <span>year</span>
                            <span>name · stack</span>
                            <span>status</span>
                        </div>
                        <ul class="ship-list" id="built-log-list">
                            {
                                homeShips.map((ship, i) => (
                                    <li
                                        class:list={[
                                            {
                                                "ship-desktop-hidden": i === 0,
                                                "ship-mobile-hidden": i >= 5,
                                            },
                                        ]}
                                    >
                                        <a
                                            href={shipHref(ship)}
                                            class="ship-row"
                                            data-name={ship.name}
                                            data-year={ship.year}
                                            data-desc={ship.desc ?? ""}
                                            data-tech={ship.tech}
                                            data-status={ship.status}
                                            data-href={shipHref(ship)}
                                        >
                                            <span class="ship-year">
                                                {ship.year}
                                            </span>
                                            <span class="ship-main">
                                                <span class="ship-name">
                                                    {ship.name}
                                                </span>
                                                <span class="ship-tech">
                                                    {ship.tech}
                                                </span>
                                            </span>
                                            <span class="ship-status">
                                                {ship.status}
                                            </span>
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
                <footer class="rail-footer">
                    <span class="rail-eyebrow"
                        >see them all · github.com/alexgaoth</span
                    >
                    <a href={APP_ROUTES.projects} class="rail-footer-link"
                        >/projects →</a
                    >
                </footer>
            </section>

            <!-- ── 02 WRITING ── -->
            <section class="rail-panel">
                <span class="rail-eyebrow">// some of my</span>
                <h2 class="rail-title">
                    WRITING<span style="color:rgba(0,0,0,0.18)">.</span>
                </h2>
                <p class="rail-sub">
                    i like to think, and make others think. To write is to
                    think. To write well is to think clearly.
                </p>

                <span class="rail-eyebrow">// recent thoughts</span>
                <div class="writing-cards">
                    {
                        WRITINGS.map((w) => (
                            <a
                                href={`${APP_ROUTES.thoughts}/${w.slug}`}
                                class="writing-card"
                            >
                                <span class="writing-pull">{w.pull}</span>
                                <span class="writing-title">{w.title}</span>
                                <span class="writing-meta">
                                    {w.date} · {w.tag} · {w.read}
                                </span>
                            </a>
                        ))
                    }
                </div>

                <span class="rail-eyebrow">// the personal side</span>
                <div class="door-rows">
                    {
                        DOORS.map((d) => (
                            <a href={d.to} class="door-row">
                                <span class="door-glyph">{d.glyph}</span>
                                <span class="door-label">{d.label}</span>
                                <span class="door-note">{d.note}</span>
                                <span class="door-arrow">→</span>
                            </a>
                        ))
                    }
                </div>

                <footer class="rail-footer">
                    <span class="rail-eyebrow"
                        >the long version is in /thoughts</span
                    >
                    <a href={APP_ROUTES.thoughts} class="rail-footer-link"
                        >/thoughts →</a
                    >
                </footer>
            </section>

            <!-- ── 03 EXPERIENCE ── -->
            <section class="rail-panel">
                <span class="rail-eyebrow">// brief summary of my</span>
                <h2 class="rail-title">
                    EXPERIENCE<span style="color:#ccc">.</span>
                </h2>
                <p class="rail-sub">ls -a | head -n 2</p>

                <div class="exp-grid">
                    <div>
                        <span class="rail-eyebrow">// work</span>
                        {
                            EXPERIENCE.map((e) => (
                                <div class="exp-row">
                                    <span class="exp-role">{e.role}</span>
                                    <span class="exp-org">
                                        {e.org} · {e.period}
                                    </span>
                                    <span class="exp-desc">{e.desc}</span>
                                </div>
                            ))
                        }
                        <span class="rail-eyebrow">// education</span>
                        {
                            EDUCATION.map((e) => (
                                <div class="exp-row">
                                    <span class="exp-role">{e.school}</span>
                                    <span class="exp-desc">{e.detail}</span>
                                </div>
                            ))
                        }
                    </div>
                    <div>
                        <span class="rail-eyebrow">// trophies</span>
                        {
                            TROPHIES.map((t) => (
                                <div class="exp-row">
                                    <span class="exp-role">
                                        {t.stamp} — {t.label}
                                    </span>
                                    <span class="exp-desc">{t.year}</span>
                                </div>
                            ))
                        }
                        <div class="inline-list">
                            <span class="rail-eyebrow">// i work in</span>
                            <span class="exp-desc">{DOMAINS.join(" · ")}</span>
                        </div>
                        <div class="inline-list">
                            <span class="rail-eyebrow">// tongues</span>
                            <span class="exp-desc">{TONGUES.join(" · ")}</span>
                        </div>
                    </div>
                </div>

                <a href={APP_ROUTES.now} class="now-strip">
                    <span class="now-dot rail-pulse"></span>
                    <span class="now-strip-label">me - rn</span>
                    <span>→</span>
                </a>

                <footer class="rail-footer">
                    <span class="rail-eyebrow">full record in /resume</span>
                    <a href={APP_ROUTES.resume} class="rail-footer-link"
                        >/resume →</a
                    >
                </footer>
            </section>

            <!-- Return stage: empty scroll distance the directory scrolls into
           view through (pre-migration return). -->
            <div class="return-spacer"></div>

            <!-- ── Directory: second title + cards, entrance driven by the return -->
            <div class="return-stage">
                <div class="cards-section-parallax" style="position:relative">
                    <div class="cards-title">
                        <div class="return-reveal-line">
                            <h2 class="title-main">alex gaoth's directory</h2>
                        </div>
                        <div class="return-reveal-line">
                            <div class="title-sub" style="padding-top:0.4rem">
                                <p>
                                    I am alex gao, the additional 'th' is here
                                    so you can find me easier
                                </p>
                                <p class="reverse-hidden">
                                    'th' is the initials of my chinese first
                                    name, and u can find me elsewhere all by
                                    alexgaoth
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="grid-2col">
                        {
                            Object.entries(content).map(([key, data]) => (
                                <a href={`/${key}`} class="card">
                                    <div class="card-image">
                                        <img
                                            src={data.previewImage}
                                            alt={`${data.title} preview`}
                                            loading="lazy"
                                        />
                                    </div>
                                    <h3 class="title-card">{data.title}</h3>
                                    <p class="card-description">
                                        {CARD_DESCRIPTIONS[key]}
                                    </p>
                                </a>
                            ))
                        }
                    </div>
                </div>

                <!-- ── Footer strips ── -->
                <div class="mainpage-footer">
                    <a
                        href={APP_ROUTES.art}
                        class="art-strip mainpage-footer-strip"
                    >
                        <span class="art-strip-label">/art</span>
                        <span class="art-strip-arrow">→</span>
                    </a>
                    <a
                        href={APP_ROUTES.gallery}
                        class="art-strip mainpage-footer-strip"
                        style="margin-top:0.5rem"
                    >
                        <span class="art-strip-label">/gallery</span>
                        <span class="art-strip-arrow">→</span>
                    </a>
                    <a
                        href={APP_ROUTES.about}
                        class="art-strip mainpage-footer-strip"
                        style="margin-top:0.5rem"
                    >
                        <span class="art-strip-label">/about</span>
                        <span class="art-strip-arrow">→</span>
                    </a>
                    <a
                        href={SITE.personalUrl}
                        class="art-strip mainpage-footer-strip"
                        style="margin-top:0.5rem"
                    >
                        <span class="art-strip-label">#contact</span>
                        <span class="art-strip-arrow">→</span>
                    </a>
                    <div class="footer">
                        <p>
                            this page is written with React @2022 (now
                            deprecated)
                        </p>
                        <p>
                            No rights reserved – this work by alex is free to
                            use for any purpose.
                        </p>
                    </div>
                </div>
            </div><!-- /return-stage -->
        </div>

        <!-- Fixed parallax chrome (hidden without JS / reduced motion) -->
        <div class="progress-track" aria-hidden="true">
            <div class="progress-fill"></div>
        </div>
        <div class="scroll-hint" aria-hidden="true">
            <span class="scroll-hint-label">scroll</span>
            <div class="scroll-line-indicator"></div>
        </div>
    </div>
</BaseLayout>

<style>
    .rail-panel {
        position: relative; /* anchors the scroll-driven wash canvas */
        /* seam size, shared with the FX canvas via var(--rail-gap). Desktop is
       viewport-relative: when a new section's transition plays (~55% up the
       screen), the outgoing one has at most ~a quarter of the viewport left.
       Mobile reads as a continuous ledger (DESIGN.md), so the gap stays small. */
        --rail-gap: clamp(3rem, 8vw, 5rem);
        margin: var(--rail-gap) 0;
        font-family: "Space Mono", monospace;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }
    @media (min-width: 768px) {
        .rail-panel {
            --rail-gap: min(30vh, 20rem);
            min-height: 100vh;
        }
        .rail-panel .rail-footer {
            margin-top: auto;
        }
    }
    /* the rail follows the intro spacer closely, as pre-migration */
    .rail-panel:first-of-type {
        --rail-gap: clamp(2rem, 5vh, 4rem);
    }
    .intro-spacer {
        position: relative;
    }
    .return-stage {
        position: relative;
    }
    .return-reveal-line {
        overflow: hidden;
    }
    .cards-title .title-main,
    .cards-title .title-sub,
    .cards-section-parallax > .grid-2col {
        will-change: transform, opacity;
    }
    /* ── fixed parallax chrome (all shown/driven by the FX script only) ── */
    .progress-track {
        position: fixed;
        left: clamp(1.2rem, 3vw, 2.8rem);
        top: 15vh;
        height: 70vh;
        width: 1px;
        background: rgba(0, 0, 0, 0.1);
        z-index: 6;
        pointer-events: none;
        display: none;
    }
    .progress-fill {
        width: 100%;
        height: 0;
        background: rgba(0, 0, 0, 0.45);
    }
    .scroll-hint {
        position: fixed;
        bottom: 2.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 8;
        pointer-events: none;
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
    }
    .scroll-hint-label {
        font-family: "Space Mono", monospace;
        font-size: 0.6rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #000;
        opacity: 0.38;
    }
    .rail-eyebrow {
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #888;
    }
    .rail-title {
        /* floats above the wash cover so the split-flap board is visible for the
       whole transition */
        position: relative;
        z-index: 4;
        font-family: "Space Grotesk", sans-serif;
        font-weight: 600;
        font-size: clamp(1.8rem, 4.8vw, 3.8rem);
        letter-spacing: -0.035em;
        line-height: 0.95;
        margin: 0;
        color: #000;
    }
    .rail-sub {
        font-size: clamp(0.68rem, 0.82vw, 0.82rem);
        color: #888;
        margin: 0 0 0.4rem;
        letter-spacing: 0.02em;
        max-width: 70ch;
        line-height: 1.5;
    }
    .rail-footer {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding-top: 0.45rem;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
    }
    .rail-footer-link {
        font-size: 11px;
        color: #000;
        letter-spacing: 0.04em;
        text-decoration: none;
        opacity: 0.85;
    }
    .built-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(0.8rem, 1.8vw, 1.6rem);
        align-items: flex-start;
    }
    .built-hero {
        display: none;
    }
    .ship-mobile-hidden {
        display: none;
    }
    @media (min-width: 768px) {
        .built-grid {
            grid-template-columns: 1.35fr 1fr;
        }
        .built-hero {
            display: flex;
            flex-direction: column;
            border: 1px solid #000;
            text-decoration: none;
            color: inherit;
            overflow: hidden;
        }
        .ship-desktop-hidden {
            display: none;
        }
        .ship-mobile-hidden {
            display: list-item;
        }
    }
    .built-hero-media {
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #f4f1ea;
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }
    .built-hero-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        opacity: 0;
        transition: opacity 0.15s;
    }
    .built-hero-img.active {
        opacity: 1;
    }
    .built-hero-live {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #000;
        color: #fff;
        padding: 3px 8px;
        font-size: 9px;
        letter-spacing: 0.22em;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .built-hero-live[hidden] {
        display: none;
    }
    .built-hero-body {
        display: flex;
        flex-direction: column;
        border-top: 1px solid #000;
        background: #fff;
        padding: 10px 14px 12px;
    }
    .built-hero-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 4px;
    }
    .built-hero-name {
        font-family: "Space Grotesk", sans-serif;
        font-size: clamp(0.92rem, 1.3vw, 1.2rem);
        letter-spacing: -0.015em;
        font-weight: 600;
    }
    .built-hero-desc {
        font-size: 11.5px;
        margin: 0 0 8px;
        line-height: 1.5;
        color: #555;
    }
    .built-hero-desc:empty {
        margin: 0;
    }
    .built-hero-chips {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }
    .built-chip {
        background: #000;
        color: #fff;
        padding: 2px 7px;
        font-size: 9.5px;
        letter-spacing: 0.06em;
    }
    .built-log {
        display: flex;
        flex-direction: column;
    }
    .built-log-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 5px;
    }
    .built-log-cols {
        display: grid;
        grid-template-columns: 44px 1fr auto;
        gap: 10px;
        padding: 4px 6px;
        border-top: 1px solid #000;
        border-bottom: 1px solid #000;
        font-size: 9px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 500;
    }
    .ship-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .ship-row {
        display: grid;
        grid-template-columns: 44px 1fr auto;
        gap: 10px;
        padding: 8px 6px;
        border-bottom: 1px solid #eee;
        align-items: center;
        text-decoration: none;
        color: #000;
        transition:
            background 0.12s,
            color 0.12s;
    }
    .ship-row:hover {
        background: #000;
        color: #fff;
    }
    .ship-year {
        font-size: 10.5px;
        font-weight: 600;
        color: #999;
    }
    .ship-row:hover .ship-year,
    .ship-row:hover .ship-tech {
        color: rgba(255, 255, 255, 0.6);
    }
    .ship-main {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .ship-name {
        font-size: 12.5px;
        font-weight: 500;
    }
    .ship-tech {
        font-size: 9.5px;
        color: #888;
        letter-spacing: 0.02em;
    }
    .ship-status {
        font-size: 8.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        border: 1px solid currentColor;
        padding: 2px 5px;
        white-space: nowrap;
    }
    .writing-cards {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .writing-card {
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding: 10px 8px;
        border: 1px solid rgba(0, 0, 0, 0.12);
        text-decoration: none;
        color: #000;
        transition:
            background 0.12s,
            color 0.12s;
    }
    .writing-card:hover {
        background: #000;
        color: #fff;
    }
    .writing-pull {
        font-size: 11px;
        color: #888;
        font-style: italic;
    }
    .writing-card:hover .writing-pull,
    .writing-card:hover .writing-meta {
        color: rgba(255, 255, 255, 0.6);
    }
    .writing-title {
        font-size: 13px;
        font-weight: 600;
    }
    .writing-meta {
        font-size: 10px;
        color: #888;
        letter-spacing: 0.06em;
    }
    .door-rows {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .door-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 8px;
        border: 1px solid #000;
        text-decoration: none;
        color: #000;
        transition:
            background 0.12s,
            color 0.12s;
    }
    .door-row:hover {
        background: #000;
        color: #fff;
    }
    .door-glyph {
        font-size: 20px;
    }
    .door-label {
        font-size: 12px;
        font-weight: 600;
    }
    .door-note {
        font-size: 10px;
        color: #888;
        flex: 1;
    }
    .door-row:hover .door-note {
        color: rgba(255, 255, 255, 0.6);
    }
    .exp-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.2rem;
    }
    @media (min-width: 768px) {
        .exp-grid {
