---
// The homepage: the title, four short sections of text each held beside a
// view of a quaternion Julia set, then the directory cards and the footer.
// The fractal (lib/qjulia/) is chrome over complete static HTML: without it
// (mobile, reduced motion, no WebGL2) the sections read as one plain column.
// Its camera journey is scripts/home-shots/make-home.mjs (see README).
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, APP_ROUTES } from "../config/site.js";
import { content } from "../data/content.js";

const CARD_DESCRIPTIONS = {
    resume: "My professional experience and skills",
    projects: "Creative projects funded by my relentless mind",
    thoughts: "Ideas worth saying - maybe worth reading",
    quotes: "The good and the bad",
};

// The slideshow, images only, in Alex's order: the reverse-engineering list,
// the map, the rest, and don't-hallucinate last. Every picture sits in the
// same 1200 × 630 frame as the project cards, and is exported at that size
// (the GitHub card, 1200 × 600, loses 2% at its sides).
const shows = [
    {
        name: "awesome-reverse-engineered",
        img: "https://opengraph.githubassets.com/1/alexgaoth/awesome-reverse-engineered",
        href: "/projects#project-awesome-reverse-engineered",
    },
    {
        name: "weighted_map",
        img: "/resources/weighted-map-driving-time-og.jpg",
        href: "/projects/maps#project-weighted-map",
    },
    {
        name: "signalor.app",
        img: "/resources/signalor-home.png",
        href: "/projects#project-signalor",
    },
    {
        name: "oats",
        img: "/resources/oats-og.png",
        href: "/projects#project-oats",
    },
    {
        name: "dont-hallucinate",
        img: "/resources/dont-hallucinate-og.png",
        href: "/projects#project-dont-hallucinate",
    },
];
---

<BaseLayout
    title={SITE.title}
    description={SITE.description}
    keywords={SITE.keywords}
    path={APP_ROUTES.home}
>
    <div class="page-container" style="background-color:#fff">
        <canvas id="qj" class="fx-canvas" aria-hidden="true"></canvas>
        <div class="fx-note" aria-hidden="true">
            <svg class="fx-note-arrow">
                <path class="fx-note-halo"></path>
                <path class="fx-note-line"></path>
            </svg>
            <p class="fx-note-text"></p>
        </div>
        <p class="fx-formula" aria-hidden="true">
            q<sub>n+1</sub> = q<sub>n</sub><sup>2</sup> + c<br />q ∈ ℍ · c = −0.2 + 0.8i · k = 0
        </p>
        <div
            class="content-wrapper"
            style="padding-top:2.5rem;padding-bottom:3rem"
        >
            <script is:inline>
                // Desktop with motion: keep the intro title out of sight until
                // its font has loaded (two seconds at most), so it never shows
                // in a fallback face before Space Grotesk arrives.
                (() => {
                    if (
                        innerWidth < 768 ||
                        matchMedia("(prefers-reduced-motion: reduce)").matches
                    )
                        return;
                    const root = document.documentElement;
                    const show = () => root.classList.remove("fx-font-wait");
                    root.classList.add("fx-font-wait");
                    document.fonts
                        .load(
                            '700 60px "Space Grotesk"',
                            "alex gaoth's directory",
                        )
                        .then(show, show);
                    setTimeout(show, 2000);
                })();
            </script>
            <div class="intro-spacer">
                <header
                    class="title-section-parallax"
                    style="position:relative"
                >
                    <!-- the "o" spans must touch "ga" and "th": any space or line break there shows as a space -->
                    <!-- prettier-ignore -->
                    <h1 class="title-main">
                        alex ga<span class="title-o"><span class="title-o-glyph">o</span></span>th's directory
                    </h1>
                    <div class="title-sub" style="padding-top:0.4rem">
                        <p>
                            I am alex gao, the additional 'th' is here so you
                            can find me easier
                        </p>
                        <p class="reverse-hidden">
                            'th' is the initials of my chinese first name, and u
                            can find me elsewhere all by alexgaoth
                        </p>
                    </div>
                </header>
            </div>

            <div class="fx-gap g0" aria-hidden="true"></div>

            <section class="fx-section" data-text="hi">
                <div class="fx-text">
                    <p class="fx-lead">hi i am alex</p>
                    <p class="fx-line">so great that you're here</p>
                    <p class="fx-line">
                        explore my favourite mathematical object with me
                    </p>
                    <p class="fx-line">as i show you around</p>
                    <br />
                    <p class="fx-line">
                        if we haven't met,
                        <a class="fx-inline" href="https://intro.alexgaoth.com">
                            here is a super quick intro
                        </a>
                    </p>
                </div>
            </section>

            <div class="fx-gap g1" aria-hidden="true"></div>

            <section class="fx-section" data-text="built">
                <div class="fx-text">
                    <p class="fx-lead">i really really enjoy building things</p>
                    <p class="fx-line">here are some things i have built</p>
                    <div class="fx-show">
                        <a class="fx-show-frame" href={shows[0].href}>
                            {shows.map((ship, i) => (
                                <img
                                    src={ship.img}
                                    alt={ship.name}
                                    data-href={ship.href}
                                    class:list={[
                                        "fx-show-img",
                                        { on: i === 0 },
                                    ]}
                                    loading={i === 0 ? "eager" : "lazy"}
                                />
                            ))}
                        </a>
                    </div>
                </div>
            </section>

            <div class="fx-gap g2" aria-hidden="true"></div>

            <section class="fx-section low" data-text="fractal">
                <div class="fx-text">
                    <p class="fx-lead">including this</p>
                    <p class="fx-line">a quaternion julia set fractal</p>
                    <p class="fx-line">
                        read more about it
                        <a
                            class="fx-inline"
                            href="https://paulbourke.net/fractals/quatjulia/"
                        >
                            here
                        </a>
                    </p>
                </div>
            </section>

            <div class="fx-gap g3" aria-hidden="true"></div>

            <section class="fx-section right" data-text="writing">
                <div class="fx-text">
                    <p class="fx-lead">i enjoy thinking deeply</p>
                    <p class="fx-line">
                        so i write! to write well is to think clearly
                    </p>

                    <p class="fx-line">
                        i attempt to theorize a society where everyone thinking
                        rationally{" "}
                        <a class="fx-inline" href="https://sublationism.com">
                            here
                        </a>
                    </p>
                </div>
            </section>

            <div class="fx-gap g4" aria-hidden="true"></div>

            <section class="fx-section right" data-text="doing">
                <div class="fx-text">
                    <p class="fx-lead">i believe in just doing things</p>
                    <p class="fx-line">
                        it yielded me with a great deal of interesting stories,
                        experience
                    </p>
                    <p class="fx-line">
                        i strongly recommend explore the rest of the site
                    </p>
                </div>
            </section>

            <div class="fx-gap g5" aria-hidden="true"></div>

            <!-- What each view shows, for the arrows the fractal layer draws
           while that view holds. dx/dy place the caption, in viewport heights
           from the view's subject: each sits in its frame's empty paper (top
           right for the face, bottom left for the cliff). -->
            <ol class="fx-notes" hidden>
                <li data-shot="face" data-dx="0.45" data-dy="-0.27">
                    cut open: the face is the flat 2d julia set
                </li>
                <li data-shot="cliff" data-dx="-0.45" data-dy="0.25">
                    the edge of the 2d set, as a cliff in 3d
                </li>
            </ol>

            <!-- Return stage: empty scroll distance the directory scrolls into
           view through. -->
            <div class="return-spacer"></div>

            <!-- ── Directory: second title + cards, entrance driven by the return -->
            <div class="return-stage">
                <div class="cards-section-parallax" style="position:relative">
                    <div class="cards-title">
                        <div class="return-reveal-line">
                            <!-- the "o" spans must touch "ga" and "th": any space or line break there shows as a space -->
                            <!-- prettier-ignore -->
                            <h2 class="title-main">
                                alex ga<span class="title-o"><span class="title-o-glyph">o</span></span>th's directory
                            </h2>
                        </div>
                        <div class="return-reveal-line">
                            <div class="title-sub" style="padding-top:0.4rem">
                                <p>
                                    I am alex gao, the additional 'th' is here
                                    so you can find me easier
                                </p>
                                <p class="reverse-hidden">
                                    'th' is the initials of my chinese first
                                    name, and u can find me elsewhere all by
                                    alexgaoth
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="grid-2col">
                        {Object.entries(content).map(([key, data]) => (
                            <a href={`/${key}`} class="card">
                                <div class="card-image">
                                    <img
                                        src={data.previewImage}
                                        alt={`${data.title} preview`}
                                        loading="lazy"
                                    />
                                </div>
                                <h3 class="title-card">{data.title}</h3>
                                <p class="card-description">
                                    {CARD_DESCRIPTIONS[key]}
                                </p>
                                <span class="card-arrow" aria-hidden="true">
                                    →
                                </span>
                            </a>
                        ))}
                    </div>
                </div>

                <!-- ── Footer strips ── -->
                <div class="mainpage-footer">
                    <a
                        href={APP_ROUTES.art}
                        class="art-strip mainpage-footer-strip"
                    >
                        <span class="art-strip-label">/art</span>
                        <span class="art-strip-arrow">→</span>
                    </a>
                    <a
                        href={APP_ROUTES.gallery}
                        class="art-strip mainpage-footer-strip"
                    >
                        <span class="art-strip-label">/gallery</span>
                        <span class="art-strip-arrow">→</span>
                    </a>
                    <a
                        href={APP_ROUTES.about}
                        class="art-strip mainpage-footer-strip"
                    >
                        <span class="art-strip-label">/about</span>
                        <span class="art-strip-arrow">→</span>
                    </a>
                    <a
                        href={SITE.personalUrl}
                        class="art-strip mainpage-footer-strip"
                    >
                        <span class="art-strip-label">#contact</span>
                        <span class="art-strip-arrow">→</span>
                    </a>
                    <div class="footer">
                        <p>
                            this page is written with React @2022 (now
                            deprecated)
                        </p>
                        <p>
                            No rights reserved – this work by alex is free to
                            use for any purpose.
                        </p>
                    </div>
                </div>
            </div>
            <!-- /return-stage -->
        </div>

        <!-- Fixed parallax chrome (hidden without JS / reduced motion) -->
        <div class="progress-track" aria-hidden="true">
            <div class="progress-fill"></div>
        </div>
        <div class="scroll-hint" aria-hidden="true">
            <span class="scroll-hint-label">scroll</span>
            <div class="scroll-line-indicator"></div>
        </div>
    </div>
</BaseLayout>

<style>
    /* ── the fractal: one fixed canvas behind the page ── */
    .fx-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        z-index: 0;
        pointer-events: none;
        opacity: 0;
        /* shown and hidden only while a title's "o" is a solid dot over the
           ball (see .via-dot below) */
        transition: opacity 0.1s linear 0.23s;
    }
    .fx-canvas.live {
        opacity: 1;
    }
    .content-wrapper {
        position: relative;
        z-index: 1;
    }
    /* a short arrow and a caption naming what a view shows, set in the
       frame's empty paper as plain text */
    .fx-note {
        position: fixed;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        opacity: 0;
    }
    .fx-note-arrow {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
    }
    .fx-note-halo,
    .fx-note-line {
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .fx-note-halo {
        stroke: #fff;
        stroke-width: 3;
        stroke-opacity: 0.6;
    }
    .fx-note-line {
        stroke: #555;
        stroke-width: 1.25;
    }
    .fx-note-text {
        position: absolute;
        margin: 0;
        max-width: 17rem;
        transform: translateY(-50%);
        font-size: clamp(0.82rem, 1vw, 0.98rem);
        font-weight: 400;
        line-height: 1.55;
        color: #555;
    }
    /* the set's definition, small in the corner while the fractal shows */
    .fx-formula {
        display: none;
        position: fixed;
        right: clamp(1.2rem, 2.4vw, 2.4rem);
        bottom: 1.1rem;
        z-index: 2;
        margin: 0;
        font-size: 11px;
        line-height: 1.7;
        letter-spacing: 0.02em;
        color: #8a8a8a;
        /* a soft paper halo, so it still reads where the fractal fills the corner */
        text-shadow:
            0 0 2px #fff,
            0 0 4px #fff,
            0 0 9px #fff;
        text-align: right;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.4s;
    }
    :global(html.fx-live) .fx-formula {
        display: block;
    }
    .fx-formula sub,
    .fx-formula sup {
        font-size: 0.72em;
        line-height: 0;
    }

    /* Both "o"s and the ball are one object. When the ball is shown or
       hidden at the same moment (.via-dot: the first nudge of scroll, and the
       second title), the letter condenses into the ball's exact footprint
       (the fractal layer measures it) while its hole closes in, so the "o"
       becomes a solid dot; the ball is put in underneath it, and the dot
       fades to reveal it. Hiding runs the same in reverse, and the canvas's
       own fade fits inside the hold where the dot is solid (.fx-canvas). When
       the ball is already on screen (the first title, rising away and coming
       back), the ring alone condenses and fades, or comes back the same way. */
    .title-o-glyph {
        position: relative;
        display: inline-block;
        transform-origin: var(--o-origin, 50% 50%);
    }
    /* the hole's closing ring: a disc in the letter's colour, centred on its
       ink, whose inset shadow starts hidden under the stroke */
    .title-o-glyph::before {
        content: "";
        position: absolute;
        left: calc(var(--o-ox, 0px) - var(--o-fill, 0px));
        top: calc(var(--o-oy, 0px) - var(--o-fill, 0px));
        width: calc(2 * var(--o-fill, 0px));
        height: calc(2 * var(--o-fill, 0px));
        border-radius: 50%;
        z-index: -1;
    }
    .title-o.as-ball .title-o-glyph {
        animation: o-settle 0.6s ease-in-out forwards;
    }
    .title-o.out-of-ball .title-o-glyph {
        animation: o-release 0.6s ease-in-out forwards;
    }
    .title-o.as-ball.via-dot .title-o-glyph {
        animation: o-reveal 0.75s ease-in-out forwards;
    }
    .title-o.as-ball.via-dot .title-o-glyph::before {
        animation: o-close 0.75s ease-in-out forwards;
    }
    .title-o.out-of-ball.via-dot .title-o-glyph {
        animation: o-conceal 0.65s ease-in-out forwards;
    }
    .title-o.out-of-ball.via-dot .title-o-glyph::before {
        animation: o-open 0.65s ease-in-out forwards;
    }
    @keyframes o-settle {
        0% {
            transform: none;
            opacity: 1;
        }
        30% {
            opacity: 1;
        }
        55% {
            transform: translateX(var(--o-dx, 0px)) scale(var(--o-scale, 1));
        }
        100% {
            transform: translateX(var(--o-dx, 0px)) scale(var(--o-scale, 1));
            opacity: 0;
        }
    }
    @keyframes o-release {
        0% {
            transform: translateX(var(--o-dx, 0px)) scale(var(--o-scale, 1));
            opacity: 0;
        }
        45% {
            transform: translateX(var(--o-dx, 0px)) scale(var(--o-scale, 1));
        }
        70% {
            opacity: 1;
        }
        100% {
            transform: none;
            opacity: 1;
        }
    }
    @keyframes o-reveal {
        0% {
            transform: none;
            opacity: 1;
        }
        30% {
            transform: translateX(var(--o-dx, 0px)) scale(var(--o-scale, 1));
        }
        44% {
            opacity: 1;
        }
        100% {
            transform: translateX(var(--o-dx, 0px)) scale(var(--o-scale, 1));
            opacity: 0;
        }
    }
    @keyframes o-close {
        0% {
            box-shadow: inset 0 0 0 var(--o-open, 0px) currentColor;
        }
        30%,
        100% {
            box-shadow: inset 0 0 0 var(--o-fill, 0px) currentColor;
        }
    }
    @keyframes o-conceal {
        0% {
            transform: translateX(var(--o-dx, 0px)) scale(var(--o-scale, 1));
            opacity: 0;
        }
        32% {
            opacity: 1;
        }
        51% {
            transform: translateX(var(--o-dx, 0px)) scale(var(--o-scale, 1));
        }
        100% {
            transform: none;
            opacity: 1;
        }
    }
    @keyframes o-open {
        0%,
        51% {
            box-shadow: inset 0 0 0 var(--o-fill, 0px) currentColor;
        }
        100% {
            box-shadow: inset 0 0 0 var(--o-open, 0px) currentColor;
        }
    }
    /* The intro title waits for its own font, so it never flashes in a
       fallback face first (set before first paint, desktop with motion only). */
    .intro-spacer .title-main {
        transition: opacity 0.4s ease-in-out 0.08s;
    }
    :global(html.fx-font-wait) .intro-spacer .title-main {
        opacity: 0;
    }

    /* ── four sections of text ── */
    .fx-section {
        display: flex;
        padding: 2.5rem 0;
        font-family: "Space Mono", monospace;
    }
    .fx-section.right {
        justify-content: flex-end;
    }
    .fx-text {
        width: min(30rem, 100%);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.55rem;
    }
    .fx-lead {
        margin: 0 0 0.35rem;
        font-family: "Space Grotesk", sans-serif;
        font-weight: 600;
        font-size: clamp(2rem, 3.8vw, 3.4rem);
        letter-spacing: -0.035em;
        line-height: 0.95;
        color: #000;
        text-wrap: balance;
    }
    .fx-line {
        margin: 0;
        font-size: clamp(0.82rem, 1vw, 0.98rem);
        line-height: 1.55;
        color: #444;
    }
    .fx-inline {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid rgba(0, 0, 0, 0.18);
        transition:
            background 0.12s,
            color 0.12s;
    }
    .fx-inline:hover {
        background: #000;
        color: #fff;
    }

    /* the slideshow of builds: one image at a time */
    .fx-show {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        margin-top: 0.35rem;
    }
    .fx-show-frame {
        position: relative;
        display: block;
        width: 100%;
        aspect-ratio: 1200 / 630;
        border: 1px solid #000;
        background: #f4f1ea;
        overflow: hidden;
    }
    .fx-show-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.25s;
    }
    .fx-show-img.on {
        opacity: 1;
    }

    /* Live, on desktop: each section becomes a long hold whose words stay
       put (sticky) while the fractal holds a view beside them; the gaps are
       the scroll the fractal travels through between sections. */
    .fx-gap {
        display: none;
    }
    @media (min-width: 768px) {
        :global(html.fx-live) .fx-section {
            height: 200vh;
            padding: 0;
            align-items: flex-start;
        }
        :global(html.fx-live) .fx-section[data-text="built"] {
            height: 280vh;
        }
        :global(html.fx-live) .fx-text {
            position: sticky;
            top: 28vh;
        }
        /* the fan fills the frame but for its lower left */
        :global(html.fx-live) .fx-section.low .fx-text {
            top: 60vh;
        }
        :global(html.fx-live) .fx-gap {
            display: block;
        }
        .g0 {
            height: 60vh;
        }
        .g1 {
            height: 100vh;
        }
        .g2 {
            height: 100vh;
        }
        .g3 {
            height: 520vh;
        }
        .g4 {
            height: 100vh;
        }
        .g5 {
            height: 60vh;
        }
    }

    /* ── kept from the homepage: intro, return stage, chrome ── */
    .intro-spacer {
        position: relative;
    }
    .return-stage {
        position: relative;
    }
    .return-reveal-line {
        overflow: hidden;
    }
    .cards-title .title-main,
    .cards-title .title-sub,
    .cards-section-parallax > .grid-2col {
        will-change: transform, opacity;
    }
    .progress-track {
        position: fixed;
        left: clamp(1.2rem, 3vw, 2.8rem);
        top: 15vh;
        height: 70vh;
        width: 1px;
        background: rgba(0, 0, 0, 0.1);
        z-index: 6;
        pointer-events: none;
        display: none;
    }
    .progress-fill {
        width: 100%;
        height: 0;
        background: rgba(0, 0, 0, 0.45);
    }
    .scroll-hint {
        position: fixed;
        bottom: 2.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 8;
        pointer-events: none;
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
    }
    .scroll-hint-label {
        font-family: "Space Mono", monospace;
        font-size: 0.6rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #000;
        opacity: 0.38;
    }
    .cards-title .title-main {
        margin-top: 0;
    }
    .card-arrow {
        display: none;
    }
    @media (max-width: 767px) {
        .cards-title {
            display: none;
        }
        .cards-section-parallax > .grid-2col {
            gap: 0;
            border-top: 1px solid #000;
        }
        :global(.cards-section-parallax > .grid-2col > .card) {
            display: grid;
            grid-template-columns: 1fr auto;
            grid-template-areas: "title arrow" "desc desc";
            align-items: baseline;
            column-gap: 10px;
            border: 0;
            border-bottom: 1px solid #eee;
            padding: 13px 2px;
        }
        :global(.cards-section-parallax > .grid-2col > .card .card-image) {
            display: none;
        }
        :global(.cards-section-parallax > .grid-2col > .card .title-card) {
            grid-area: title;
            font-size: 13px;
            margin: 0;
        }
        :global(
            .cards-section-parallax > .grid-2col > .card .card-description
        ) {
            grid-area: desc;
            font-size: 10.5px;
            margin-top: 3px;
            opacity: 1;
            color: #888;
        }
        :global(.cards-section-parallax > .grid-2col > .card .card-arrow) {
            display: block;
            grid-area: arrow;
            font-size: 11px;
            color: #bbb;
        }
    }
</style>

<script>
    // The builds slideshow: while its section holds, scrolling turns the
    // images over, and the frame links to whichever is showing. Without JS it
    // shows the first.
    const show = document.querySelector(".fx-show");
    if (show) {
        const imgs = [...show.querySelectorAll(".fx-show-img")];
        const frame = show.querySelector(".fx-show-frame");
        const section = show.closest(".fx-section");
        let current = 0;
        const set = (i) => {
            if (i === current) return;
            current = i;
            imgs.forEach((img, k) => img.classList.toggle("on", k === i));
            frame.setAttribute("href", imgs[i].dataset.href);
        };
        const follow = () => {
            if (!document.documentElement.classList.contains("fx-live")) return;
            const vh = innerHeight;
            const text = section.querySelector(".fx-text");
            const top = section.getBoundingClientRect().top + scrollY;
            const a = top - 0.28 * vh;
            const b =
                top + section.offsetHeight - text.offsetHeight - 0.28 * vh;
            set(
                Math.min(
                    imgs.length - 1,
                    Math.max(
                        0,
                        Math.floor(((scrollY - a) / (b - a)) * imgs.length),
                    ),
                ),
            );
        };
        addEventListener("scroll", () => requestAnimationFrame(follow), {
            passive: true,
        });
    }
</script>

<script>
    // The fractal: desktop only, loaded after the page, never on mobile or
    // under reduced motion (motionEnabled), and it adds nothing to the HTML.
    import { motionEnabled } from "../lib/homeScroll.js";
    if (motionEnabled()) import("../lib/qjulia/home.js").then((m) => m.run());
</script>

<script>
    // DOM choreography for the intro and return stages: the fixed title rise,
    // the directory reveal, the progress track and the scroll hint.
    import {
        motionEnabled,
        subscribe,
        RETURN_VH,
        TITLE_HOLD_VH,
    } from "../lib/homeScroll.js";

    // The intro runs long, so the subtitle about "th" stays up while the ball
    // comes out of the title.
    const INTRO_VH = 3.0; // viewport heights of intro scroll
    const RISE = 0.3; // share of it the title takes to rise to the top
    const FADE = 0.75; // share after which title and subtitle fade

    if (motionEnabled()) {
        const introSpacer = document.querySelector(".intro-spacer");
        const introTitle = document.querySelector(
            ".intro-spacer .title-section-parallax",
        );
        const introSub = introTitle && introTitle.querySelector(".title-sub");
        const returnSpacer = document.querySelector(".return-spacer");
        const returnStage = document.querySelector(".return-stage");
        const returnTitle =
            returnStage &&
            returnStage.querySelector(".cards-title .title-main");
        const returnSub =
            returnStage && returnStage.querySelector(".cards-title .title-sub");
        const returnCards =
            returnStage &&
            returnStage.querySelector(".cards-section-parallax > .grid-2col");
        const track = document.querySelector(".progress-track");
        const fill = document.querySelector(".progress-fill");
        let titleH = 0;

        if (introTitle) {
            introTitle.style.cssText =
                "position:fixed;left:50%;transform:translateX(-50%);z-index:10;" +
                "max-width:1152px;width:calc(100% - 64px);";
        }

        const introFx = (vh) => {
            if (!introTitle) return;
            const introH = vh * INTRO_VH;
            // the title holds still for the first nudge, while its "o"
            // turns into the ball (TITLE_HOLD_VH), then rises
            const rise = Math.min(
                1,
                Math.max(0, (scrollY - vh * TITLE_HOLD_VH) / (introH * RISE)),
            );
            const intro = Math.min(1, Math.max(0, scrollY / introH));
            const eased = 1 - Math.pow(1 - rise, 5);
            const startTop = (vh - titleH) * 0.5;
            introTitle.style.top =
                (startTop + (80 - startTop) * eased).toFixed(1) + "px";
            const op = Math.max(
                0,
                1 - Math.max(0, (intro - FADE) / (1 - FADE)),
            );
            introTitle.style.opacity = op.toFixed(3);
            introTitle.style.pointerEvents = op > 0 ? "auto" : "none";
            if (introSub) {
                introSub.style.opacity = Math.max(
                    0,
                    (rise - 0.8) / 0.2,
                ).toFixed(3);
            }
        };

        const revealFromGround = (el, p) => {
            if (!el) return;
            const eased = p * p * (3 - 2 * p);
            el.style.opacity = p > 0 ? "1" : "0";
            el.style.transform = `translateY(${((1 - eased) * 105).toFixed(1)}%)`;
        };

        const returnFx = (state) => {
            const rp = state.ret;
            revealFromGround(
                returnTitle,
                Math.min(1, Math.max(0, (rp - 0.46) / 0.38)),
            );
            revealFromGround(
                returnSub,
                Math.min(1, Math.max(0, (rp - 0.58) / 0.34)),
            );
            if (returnCards) {
                const cardP = Math.min(1, Math.max(0, (rp - 0.78) / 0.22));
                const eased = cardP * cardP * (3 - 2 * cardP);
                returnCards.style.opacity = cardP.toFixed(3);
                returnCards.style.transform = `translateY(${((1 - eased) * 24).toFixed(1)}px)`;
            }
        };

        subscribe(
            (state) => {
                const vh = innerHeight;
                introFx(vh);
                returnFx(state);
                if (track && fill) {
                    const trackedEnd = state.returnRect.bottom + scrollY;
                    track.style.display =
                        scrollY < trackedEnd ? "block" : "none";
                    fill.style.height = (state.total * 100).toFixed(2) + "%";
                }
            },
            {
                onResize: () => {
                    const vh = innerHeight;
                    if (introSpacer)
                        introSpacer.style.height =
                            Math.round(vh * INTRO_VH) + "px";
                    if (returnSpacer)
                        returnSpacer.style.height =
                            Math.round(vh * RETURN_VH) + "px";
                    if (introTitle) titleH = introTitle.offsetHeight;
                },
            },
        );

        const hint = document.querySelector(".scroll-hint");
        if (hint) {
            let hintT;
            const armHint = () => {
                hint.style.display = "none";
                clearTimeout(hintT);
                hintT = setTimeout(() => {
                    hint.style.display = "flex";
                }, 5000);
            };
            addEventListener("scroll", armHint, { passive: true });
            armHint();
        }
    }
</script>
