---
// A project group's subpage: the group's own copy, then one ProjectCard per
// member. Groups come from content.projects.groups; see projectPages.js.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavigationBar from '../../components/NavigationBar.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { APP_ROUTES } from '../../config/site.js';
import { getProjectGroups, projectSlug } from '../../lib/projectPages.js';

export function getStaticPaths() {
  return getProjectGroups().map((group) => ({
    params: { slug: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props;
---

<BaseLayout
  title={`${group.name} — Alex Gao`}
  description={group.description}
  keywords={['Alex Gao', 'alexgaoth', group.name, ...group.tech.split(',').map((t) => t.trim())]}
  path={`${APP_ROUTES.projects}/${group.slug}`}
  imagePath={group.image}
>
  <NavigationBar backHref={APP_ROUTES.projects} backLabel="Back" />
  <div class="page-container">
    <div class="content-wrapper-narrow">
      <h1 class="title-page">{group.name}</h1>
      <p class="group-desc">{group.description}</p>

      <div class="grid-1col">
        {group.members.map((project) => (
          <div id={`project-${projectSlug(project.name)}`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .group-desc {
    font-size: 0.82rem;
    line-height: 1.7;
    max-width: 62ch;
    color: #666;
    margin-bottom: 1.8rem;
  }
</style>
