---
// /about — the canonical identity page, and the one page deliberately outside
// the ink/mono design system (DESIGN.md). A researcher's homepage: system
// sans, default browser link colours, no nav bar, no islands, no motion.
//
// It is PROSE, on purpose. No lists, no year/role grid, no tables — the moment
// this page starts tabulating it becomes a second /resume, and /resume already
// exists and is the one that stays in sync with content.js. Everything here is
// paragraphs with the links sitting inside the sentences.
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_ROUTES, SITE, buildAppUrl } from '../config/site.js';
import { profileData } from '../data/profileData.js';
import { content } from '../data/content.js';

const { education, achievements } = content.resume.content;

// Bare hostnames — the point of the line is that three hosts are one person,
// so the scheme and the trailing slash are noise.
const mirrors = profileData.mirrors.map((m) => ({
  href: m.href,
  host: m.href.replace(/^https:\/\//, '').replace(/\/$/, ''),
}));

// The socials, named in a sentence rather than listed. 'x / twitter' is the
// data's label for one thing; prose only wants the first half of it.
const socials = profileData.links.map((l) => ({
  href: l.href,
  word: l.label.split(' / ')[0],
}));

const profileStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: `${SITE.name} (${SITE.handle})`,
    url: buildAppUrl(APP_ROUTES.about),
    mainEntity: {
      '@type': 'Person',
      name: SITE.name,
      alternateName: profileData.aliases,
      url: SITE.rootUrl,
      // /about is the canonical identity page — everything
      // below mirrors facts visible on this page, nothing more.
      sameAs: [...SITE.socialProfiles, SITE.personalUrl],
      email: `mailto:${profileData.email}`,
      description: SITE.description,
      jobTitle: 'Student Builder',
      affiliation: [
        { '@type': 'CollegeOrUniversity', name: 'UC San Diego' },
      ],
      alumniOf: education.map((e) => ({
        '@type': 'EducationalOrganization',
        name: e.institution,
      })),
      award: achievements.map((a) => `${a.title}, ${a.organization} (${a.year})`),
      knowsAbout: ['software', 'writing', 'mathematical thinking'],
      knowsLanguage: ['English', 'Chinese', 'Tamil'],
      mainEntityOfPage: buildAppUrl(APP_ROUTES.about),
    },
  },
];
---

<BaseLayout
  title="Alex Gao (alexgaoth)"
  description="Alex Gao (alexgaoth) — math and computer science at UC San Diego, CTO of Signalor. What he builds, what he writes, and where to find the rest."
  keywords={[...profileData.searchableQueries, 'about', 'profile', 'Tianhao Gao']}
  path={APP_ROUTES.about}
  structuredData={profileStructuredData}
>
  <main class="acad">
    <h1>Alex Gao</h1>
    <p class="onpaper">tianhao gao &middot; alexgaoth</p>

    <hr />

    <p>
      i'm alex gao — tianhao on paper, alexgaoth everywhere else. the 'th' is my
      chinese first name, and it's there so you can find me easier. i study math
      and computer science at <a href="https://ucsd.edu">uc san diego</a>, after
      two years at st paul's in london doing double maths, physics and computer
      science, where i also picked up golds at the british informatics olympiad
      and the british mathematical olympiad.
    </p>

    <p>
      most of what i do is build. i cofounded
      <a href="https://signalor.app">signalor</a> with matthieu fuller and have
      been its cto since 2025 — it reads what the internet says about a brand
      and turns that into something an investor can act on. this summer i was a
      software and devops intern at ibm in san jose, on the aiops team behind
      watsonx assistant for z; before that i wrote crawlers for esg and bond
      data at climind, remotely from london while i was still sitting a-levels.
      there are smaller things too: a
      <a href="https://intro.alexgaoth.com/JuliaSetFractal/">3d julia set simulator</a>
      i made at fifteen because i was in love with pure maths, a
      <a href="https://pypi.org/project/dont-hallucinate/">tool</a> that catches
      coding agents when they fail and tells them off, a tracker for ucsd's
      crime log.
    </p>

    <p>
      the other half is writing. i like to think, and make others think — mostly
      history and philosophy: what happened at
      <a href={`${APP_ROUTES.thoughts}/winning-the-battle-of-manzikert`}>manzikert</a>
      versus what everyone later decided happened, lacan's
      <a href={`${APP_ROUTES.thoughts}/submitting-to-the-symbolic-order`}>symbolic order</a>,
      whether china could invent a nation and defend it at the same time. i keep
      chinese poetry and ci as well, most of it written around fifteen, abroad,
      with too much free time.
    </p>

    <p>
      everything i've built is at <a href={APP_ROUTES.projects}>/projects</a>,
      with source on <a href="https://github.com/alexgaoth">github</a>. the
      essays are at <a href={APP_ROUTES.thoughts}>/thoughts</a> and the verse at
      <a href={APP_ROUTES.writing}>/writing</a>. the plain record — every job,
      every date — is at <a href={APP_ROUTES.resume}>/resume</a>, and whatever
      i'm actually doing this month is at <a href={APP_ROUTES.now}>/now</a>.
      otherwise: <a href={`mailto:${profileData.email}`}>{profileData.email}</a>,
      and alexgaoth on {socials.map((sc, i) => (
        <><a href={sc.href} rel="me">{sc.word}</a>{i < socials.length - 2 ? ', ' : i === socials.length - 2 ? ' and ' : ''}</>
      ))} — same handle everywhere, which was the whole point.
    </p>

    <p class="home"><a href={APP_ROUTES.home}>&larr; alexgaoth.com</a></p>

    <hr />

    {/* kept verbatim for findability — see profileData.js */}
    <p class="fine">
      also indexed as {profileData.aliases.join(', ')}. mirrors: {mirrors.map((m, i) => (
        <><a href={m.href}>{m.host}</a>{i < mirrors.length - 1 ? ', ' : '.'}</>
      ))}
    </p>
  </main>
</BaseLayout>

<style>
  /* The site-wide reset in global.css zeroes every margin, so the browser
     defaults this page wants have to be asked for back. That is the whole
     stylesheet — no colours on links, no borders, no grid. */
  .acad {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #222;
    max-width: 38rem;
    margin: 0 auto;
    padding: 2.5rem 1.1rem 4rem;
  }

  .acad h1 {
    font-size: 1.6rem;
    font-weight: bold;
    margin: 0;
  }

  .acad p {
    margin: 0 0 1.15em;
  }

  .acad hr {
    border: 0;
    border-top: 1px solid #ccc;
    margin: 1.3rem 0;
  }

  .onpaper {
    color: #666;
    font-size: 13px;
    margin: 0.15rem 0 0;
  }

  .home {
    margin-bottom: 0;
  }

  .fine {
    font-size: 13px;
    color: #555;
    margin-bottom: 0;
  }
</style>
