---
// Static port of the old React page ProjectsPage.jsx (data={content.projects}).
// The compact-view toggle (CompactViewButton + compacting grid) is a JS-only
// visual nicety and is intentionally dropped; the default expanded layout is
// what the CRA page renders on load.
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPage from '../components/ContentPage.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { APP_ROUTES } from '../config/site.js';
import { content } from '../data/content.js';
import { getProjectGroups, projectSlug } from '../lib/projectPages.js';

const data = content.projects;

// Grouped cards collapse into one card, placed where the first member sits.
const groups = getProjectGroups();
const seenGroups = new Set();
const entries = [];
for (const project of data.content) {
  if (!project.group) {
    entries.push({ project });
  } else if (!seenGroups.has(project.group)) {
    seenGroups.add(project.group);
    entries.push({ group: groups.find((g) => g.slug === project.group) });
  }
}
---

<BaseLayout
  title="Projects — Alex Gao"
  description="Things Alex Gao (alexgaoth) has built."
  keywords={['Alex Gao', 'alexgaoth', 'Student Builder', 'projects']}
  path={APP_ROUTES.projects}
>
  <ContentPage>
    <h1 class="title-page">Things That I've Made</h1>

    <div class="grid-1col">
      {entries.map(({ project, group }) =>
        group ? (
          <a href={`${APP_ROUTES.projects}/${group.slug}`} id={`group-${group.slug}`} class="group-card">
            <ProjectCard project={group} />
          </a>
        ) : (
          <div id={`project-${projectSlug(project.name)}`}>
            <ProjectCard project={project} />
          </div>
        ),
      )}
    </div>
  </ContentPage>
</BaseLayout>

<style>
  /* A group card is one link to its subpage. Hover inverts, per DESIGN.md;
     the trailing arrow says it opens at rest, where there is no hover. */
  .group-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .group-card :global(.title-card)::after {
    content: ' →';
  }
  .group-card:hover :global(.project-card) {
    background: #000;
    color: #fff;
  }
  .group-card:hover :global(.text-gray) {
    color: rgba(255, 255, 255, 0.7);
  }
  .group-card:hover :global(.tag) {
    background: #fff;
    color: #000;
  }
</style>

<script>
  // Minimal image-carousel replacement for the React state in ProjectCard.jsx.
  // Without JS, the first image of each project is still visible in the HTML.
  document.querySelectorAll('.project-image-container').forEach((container) => {
    const images = container.querySelectorAll('.project-image');
    if (images.length <= 1) return;
    const counter = container.querySelector('.image-counter');
    let current = 0;
    const show = (i) => {
      current = (i + images.length) % images.length;
      images.forEach((img, j) => {
        img.style.display = j === current ? '' : 'none';
      });
      if (counter) counter.textContent = `${current + 1} / ${images.length}`;
    };
    container.querySelector('.image-nav-btn.prev')?.addEventListener('click', () => show(current - 1));
    container.querySelector('.image-nav-btn.next')?.addEventListener('click', () => show(current + 1));
  });
</script>
